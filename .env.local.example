# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Calendar Integration (server-side only)
# Paste the full contents of your service account JSON key file as a single line
GCAL_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...","client_email":"..."}

# Public base URL used to build deep links inside Google Calendar event
# descriptions (e.g. "Open job in IM Ops: https://ops.example.com/jobs/…").
# Dev fallback is http://localhost:3000 if unset; on Vercel the deploy URL
# is used automatically. Set explicitly in prod to your stable domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Growth › SEO dashboard (Google Search Console) — all server-side only
# ------------------------------------------------------------------

# Dedicated, READ-ONLY GSC service account (separate from the GCAL account so
# permissions/rotation/audit stay isolated). Paste the full JSON key as a
# single line. Grant this account's client_email access to the Search Console
# property, and enable the Search Console API in the Cloud project.
GSC_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"im-ops-search-console@...iam.gserviceaccount.com"}

# The Search Console property to query. Domain property recommended (covers
# http/https/www/non-www). Format: sc-domain:<domain>
GSC_SITE_URL=sc-domain:indo-mover.com

# Supabase SERVICE ROLE key — used ONLY by the background SEO sync to bypass RLS
# when upserting Search Console metrics. NEVER expose to the browser and NEVER
# prefix with NEXT_PUBLIC_. Find it in Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared secret for the daily Vercel Cron sync endpoint. The cron request must
# send `Authorization: Bearer <CRON_SECRET>`. Generate a long random value.
CRON_SECRET=your_random_cron_secret
